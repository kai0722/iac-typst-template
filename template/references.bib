@article{Bolcar2005,
abstract = {Multi-aperture systems allow a natural method of implementing phase diversity for the joint estimation of both pupil aberrations and an image of the object. Instead of creating diversity images by means of focus adjustments, one can actuate the individual sub-apertures of the system (e.g., with a piston phase) to introduce known phase diversity. Implementation of a nonlinear optimization routine is discussed. Through digital simulation, this paper investigates the performance of a sub-aperture piston diversity algorithm by tracking Strehl ratio and the probability and speed of convergence of the nonlinear optimization routine.},
author = {Bolcar, Matthew R. and Fienup, James R.},
