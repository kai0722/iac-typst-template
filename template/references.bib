title = {{Method of phase diversity in multi-aperture systems utilizing individual sub-aperture control}},
url = {http://proceedings.spiedigitallibrary.org/proceeding.aspx?articleid=868635{\%}5Cnhttp://www.optics.rochester.edu/workgroups/fienup/PUBLICATIONS/BolcarSPIE5896{\_}14PDpiston.pdf},
