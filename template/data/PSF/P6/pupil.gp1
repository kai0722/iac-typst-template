set pm3d
set pm3d map
set ticslevel 0
set size ratio -1
set palette defined (0 "black", 1 "white")
set ylabel "[m]"
set xlabel "[m]"
set format cb "%.1f"
wvl = 4e-6



r = 0.15
set xtics format "%.1f"
set ytics format "%.1f"
set cbtics format "%.1f"
set xrange[-r:r]
set yrange[-r:r]
set xtics r/2
set ytics r/2
#set zrange[-5:5]
set cbrange[0:1]

set tics font "Consolas,12"   # 目盛りのフォントの変更
set key font "Consolas,12"
set title font "Consolas,12"
set xlabel font "Consolas,12"
set ylabel font "Consolas,12"
set zlabel font "Consolas,12"
set y2label font "Consolas,12"




splot "pupil.dat" u 2:1:3 with pm3d ti ""
set terminal pdf enhanced color size 5.0in, 4.5in
set output "pupil.pdf"
replot
set output
set terminal wxt
set term pngcairo enhanced size 1000,900
set output "pupil.png"
replot
set output
set terminal wxt



